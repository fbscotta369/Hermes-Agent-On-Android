if PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    :
else
    PROJECT_ROOT="$(pwd)"
fi

PROJECT_NAME="$(basename "$PROJECT_ROOT")"

PROJECT_SLUG="$(
    printf '%s' "$PROJECT_NAME" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//'
)"

if [[ -z "$PROJECT_SLUG" ]]; then
    PROJECT_SLUG="project"
fi

PROJECT_SECRET_DIR="$HOME/.config/a2a-projects/$PROJECT_SLUG"

export PROJECT_ROOT
export PROJECT_NAME
export PROJECT_SLUG
export PROJECT_SECRET_DIR

set -a

if [[ -f "$PROJECT_SECRET_DIR/app.env" ]]; then
    source "$PROJECT_SECRET_DIR/app.env"
fi

if [[ -f "$PROJECT_SECRET_DIR/ai-providers.env" ]]; then
    source "$PROJECT_SECRET_DIR/ai-providers.env"
fi

set +a
