#!/usr/bin/env bash
# install-hooks — Install Git hooks for this repository
# Usage: ./scripts/install-hooks

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || { echo "Not in a git repo"; exit 1; })
HOOKS_DIR="$REPO_ROOT/.githooks"

say()  { printf '\033[1;36m[install-hooks]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[install-hooks]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[install-hooks]\033[0m %s\n' "$*" >&2; }
ok()   { printf '\033[1;32m[install-hooks]\033[0m %s\n' "$*"; }

mkdir -p "$HOOKS_DIR"

# Pre-commit hook: secret scanning
cat > "$HOOKS_DIR/pre-commit" << 'EOF'
#!/usr/bin/env bash
# Git pre-commit hook: Secret scanning
# Blocks commits containing potential secrets (API keys, tokens, private keys)

set -euo pipefail

# Patterns that indicate potential secrets
patterns=(
  "sk-[a-zA-Z0-9]{32,}"           # OpenAI API keys
  "sk-ant-[a-zA-Z0-9_-]{95,}"     # Anthropic API keys
  "AIza[0-9A-Za-z\-_]{35}"        # Google API keys
  "gh[pousr]_[a-zA-Z0-9]{36,}"    # GitHub tokens
  "xox[baprs]-[a-zA-Z0-9-]{10,}"  # Slack tokens
  "ghp_[a-zA-Z0-9]{36}"           # GitHub PAT (classic)
  "github_pat_[a-zA-Z0-9_]{82}"   # GitHub PAT (fine-grained)
  "AKIA[0-9A-Z]{16}"              # AWS access key ID
  "-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----"  # Private keys
)

# Files to scan (staged files only)
mapfile -t staged_files < <(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -v '^$' || true)

if [[ ${#staged_files[@]} -eq 0 ]]; then
  exit 0
fi

found=0
for pattern in "${patterns[@]}"; do
  for f in "${staged_files[@]}"; do
    if [[ -f "$f" ]] && grep -q -E "$pattern" "$f" 2>/dev/null; then
      echo "❌ Potential secret detected in $f (pattern: $pattern)"
      grep -n -E "$pattern" "$f" | head -3 | sed 's/^/   /'
      found=1
    fi
  done
done

if [[ $found -eq 1 ]]; then
  echo ""
  echo "Commit blocked. Remove secrets from staged files before committing."
  echo "If this is a false positive, use: git commit --no-verify"
  exit 1
fi

exit 0
EOF

chmod +x "$HOOKS_DIR/pre-commit"
ok "Created $HOOKS_DIR/pre-commit"

# Configure git to use .githooks directory
git config core.hooksPath .githooks
ok "Set core.hooksPath=.githooks"

# Verify existing pre-push hook is still there
if [[ -f "$HOOKS_DIR/pre-push" ]]; then
  ok "Pre-push hook already exists (a2a guard)"
else
  warn "No pre-push hook found — run 'a2a init' to install A2A guard"
fi

say "Hooks installed. Test with: git commit --dry-run"