#!/usr/bin/env bash
# a2a-check — A2A protocol compliance validator
# Usage: a2a-check [--fix]
# Exit codes: 0 = pass, 1 = violations found, 2 = error

set -euo pipefail

A2A_DIR="a2a"
REQUIRED_FILES=(
  "STATE.md"
  "LOG.md"
  "TASKS.md"
  "ISSUES.md"
  "DECISIONS.md"
  "TECHNICAL.md"
  "WHAT.md"
)

SECRET_PATTERNS=(
  "sk-[a-zA-Z0-9]{32,}"
  "sk-ant-[a-zA-Z0-9_-]{95,}"
  "AIza[0-9A-Za-z\-_]{35}"
  "gh[pousr]_[a-zA-Z0-9]{36,}"
  "xox[baprs]-[a-zA-Z0-9-]{10,}"
  "ghp_[a-zA-Z0-9]{36}"
  "github_pat_[a-zA-Z0-9_]{82}"
  "AKIA[0-9A-Z]{16}"
  "-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----"
)

FIX_MODE=false
if [[ "${1:-}" == "--fix" ]]; then
  FIX_MODE=true
fi

say()  { printf '\033[1;36m[a2a-check]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[a2a-check]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[a2a-check]\033[0m %s\n' "$*" >&2; }
ok()   { printf '\033[1;32m[a2a-check]\033[0m %s\n' "$*"; }

VIOLATIONS=0

check_required_files() {
  say "Checking required A2A files..."
  for f in "${REQUIRED_FILES[@]}"; do
    if [[ -f "$A2A_DIR/$f" ]]; then
      ok "  $A2A_DIR/$f exists"
    else
      err "  MISSING: $A2A_DIR/$f"
      ((VIOLATIONS++))
    fi
  done
}

check_duplicate_ids() {
  say "Checking for duplicate ID definitions..."
  local ids=()
  local duplicates=0

  # Only match ID definitions (headings like "## BUG-004 —" or "### BUG-004 —")
  # Not references in "Related:" sections
  local def_pattern='^#{2,3} (BUG|PTI|ARCH|AUDIT)-[0-9]{3}'

  for f in "$A2A_DIR"/*.md; do
    [[ -f "$f" ]] || continue
    while IFS= read -r line; do
      if [[ "$line" =~ $def_pattern ]]; then
        id="${BASH_REMATCH[0]#*# }"  # Remove leading "## " or "### "
        id="${id%% —*}"              # Remove " — title" part
        ids+=("$id:$f:$line")
      fi
    done < "$f"
  done

  # Find duplicates
  declare -A seen
  for entry in "${ids[@]}"; do
    id="${entry%%:*}"
    if [[ -n "${seen[$id]:-}" ]]; then
      err "  DUPLICATE ID DEFINITION: $id"
      err "    First: ${seen[$id]}"
      err "    Second: $entry"
      ((duplicates++))
    else
      seen[$id]="$entry"
    fi
  done

  if [[ $duplicates -eq 0 ]]; then
    ok "  No duplicate ID definitions found (${#ids[@]} total definitions)"
  else
    ((VIOLATIONS += duplicates))
  fi
}

check_state_freshness() {
  say "Checking A2A-WIP.md staleness (STATE.md)..."
  
  if [[ ! -f "$A2A_DIR/STATE.md" ]]; then
    err "  STATE.md not found"
    ((VIOLATIONS++))
    return
  fi

  # Check if STATE.md has been updated recently (within last 7 days)
  local state_age_days
  state_age_days=$(( ($(date +%s) - $(stat -c %Y "$A2A_DIR/STATE.md" 2>/dev/null || stat -f %m "$A2A_DIR/STATE.md" 2>/dev/null || echo 0)) / 86400 ))
  
  if [[ $state_age_days -gt 7 ]]; then
    warn "  STATE.md is $state_age_days days old (consider updating)"
    # Warning only, not a violation
  else
    ok "  STATE.md updated $state_age_days days ago"
  fi

  # Check if STATE.md has the required sections
  local required_sections=("Objective" "In progress" "Next steps" "Verify")
  for section in "${required_sections[@]}"; do
    if grep -q "^## $section" "$A2A_DIR/STATE.md"; then
      ok "  STATE.md has '## $section' section"
    else
      err "  STATE.md missing '## $section' section"
      ((VIOLATIONS++))
    fi
  done
}

check_secrets() {
  say "Checking for secrets in A2A files..."
  local found=0

  for f in "$A2A_DIR"/*.md; do
    [[ -f "$f" ]] || continue
    for pattern in "${SECRET_PATTERNS[@]}"; do
      if grep -q -E "$pattern" "$f" 2>/dev/null; then
        err "  Potential secret in $f (pattern: $pattern)"
        grep -n -E "$pattern" "$f" | head -3 | sed 's/^/    /'
        ((found++))
      fi
    done
  done

  if [[ $found -eq 0 ]]; then
    ok "  No secrets detected in A2A files"
  else
    ((VIOLATIONS += found))
  fi
}

check_git_tracking() {
  say "Checking git tracking..."
  
  if ! git ls-files --error-unmatch "$A2A_DIR/STATE.md" >/dev/null 2>&1; then
    err "  STATE.md is not tracked by git (gitignored or never committed)"
    ((VIOLATIONS++))
  else
    ok "  STATE.md is tracked by git"
  fi

  for f in "${REQUIRED_FILES[@]}"; do
    if [[ -f "$A2A_DIR/$f" ]] && ! git ls-files --error-unmatch "$A2A_DIR/$f" >/dev/null 2>&1; then
      warn "  $A2A_DIR/$f is not tracked by git"
    fi
  done
}

check_handoff_freshness() {
  say "Checking handoff freshness..."
  
  local last_state_commit
  last_state_commit=$(git log -1 --format=%H -- "$A2A_DIR/STATE.md" 2>/dev/null || true)
  
  if [[ -z "$last_state_commit" ]]; then
    err "  STATE.md has no commit history"
    ((VIOLATIONS++))
    return
  fi

  local changed
  changed=$(git log --format=%H "$last_state_commit"..HEAD -- . ":(exclude)$A2A_DIR/" 2>/dev/null | wc -l | tr -d ' ')
  
  if [[ $changed -gt 0 ]]; then
    warn "  $changed commit(s) changed code after STATE.md was last updated"
    if [[ "$FIX_MODE" == "true" ]]; then
      warn "  Run 'a2a handoff' or update STATE.md manually"
    fi
  else
    ok "  Handoff is current (no code changes since last STATE.md update)"
  fi
}

main() {
  say "A2A Protocol Compliance Check v1.0"
  echo

  check_required_files
  echo
  check_duplicate_ids
  echo
  check_state_freshness
  echo
  check_secrets
  echo
  check_git_tracking
  echo
  check_handoff_freshness
  echo

  if [[ $VIOLATIONS -eq 0 ]]; then
    ok "All checks passed ✓"
    exit 0
  else
    err "$VIOLATIONS violation(s) found"
    exit 1
  fi
}

main "$@"